flowchart LR
    visitor["Anonymous Visitor"]
    buyer["Buyer"]
    merchant["Merchant"]
    contributor["Contributor"]
    admin["Admin"]
    paymentProvider["Payment Provider or Mock Gateway"]

    subgraph marketplace["Multi-Tenant Digital Product Marketplace"]
        direction TB

        subgraph auth["Authentication"]
            direction TB
            signUp(["Sign up"])
            signIn(["Sign in"])
            signOut(["Sign out"])
        end

        subgraph discovery["Storefront and Discovery"]
            direction TB
            browseStores(["Browse active storefronts"])
            browseProducts(["Browse published products"])
            searchProducts(["Search and filter products"])
            viewProduct(["View product detail"])
            viewReviews(["View ratings and reviews"])
        end

        subgraph commerce["Cart, Checkout, and Library"]
            direction TB
            manageCart(["Manage cart"])
            checkout(["Checkout"])
            createPaymentSession(["Create payment session"])
            handlePaymentResult(["Handle payment success, failure, or cancellation"])
            grantAccess(["Grant product access"])
            viewHistory(["View purchase history"])
            viewLibrary(["View product library"])
            submitReview(["Submit product review"])
        end

        subgraph storeOps["Merchant and Contributor Operations"]
            direction TB
            createStore(["Create tenant store"])
            manageStore(["Manage own or assigned store"])
            manageContributors(["Manage contributors and permissions"])
            manageProducts(["Create and edit products"])
            manageProductMedia(["Upload images and private files"])
            publishProducts(["Publish or unpublish products"])
            viewDashboard(["View store dashboard"])
        end

        subgraph adminOps["Admin Operations"]
            direction TB
            manageUsers(["Manage users"])
            manageMerchants(["Manage merchants"])
            manageStores(["Suspend stores"])
            manageCategories(["Manage categories"])
            manageVisibility(["Manage product visibility"])
            moderateReviews(["Moderate reviews"])
            manageConfig(["Manage marketplace configuration"])
        end
    end

